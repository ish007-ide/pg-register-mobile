VITE_API_URL=http://localhost:4000

# Must match the backend's SERVICE_TOKEN or manual entries are rejected.
# This ships to the browser — it gates the LAN, not the user.
VITE_SERVICE_TOKEN=change-me

# Only used to shade near-misses on the unknown-faces page. Set it to whatever
# the recognition service is actually running.
VITE_MATCH_THRESHOLD=0.42
