PORT=4000

# Where guests.json / logs.json / unknown.json live. Left unset, the server
# resolves ../../data relative to itself, which is correct for this tree.
# Only set it if you move the data dir, and use an absolute path if you do —
# a relative one resolves against the working directory, not this file.
# DATA_DIR=/srv/pg-register/data

# The register rolls over to "everyone in" at this hour. 4am is the point
# where a missed recognition stops compounding.
DAY_RESET_HOUR=4

CORS_ORIGIN=http://localhost:5173

# Shared secret the recognition service and the manual-entry form both send.
# Without it, any device on the PG wifi can post movements into the register.
SERVICE_TOKEN=change-me

# --- live door view ------------------------------------------------------
# No browser has asked for a frame in this long -> tell the recognition
# service to stop making them. This is the switch that works by itself.
LIVE_VIEW_TIMEOUT_MS=10000

# A frame older than this is history, not a live view.
LIVE_VIEW_TTL_MS=6000

# --- adding a guest from the dashboard -----------------------------------
# Used to run recognition/enroll.py. Set it to the venv's python if the
# recognition dependencies live in one.
# PYTHON_BIN=/srv/pg-register/recognition/.venv/bin/python

# Generous on purpose: the very first enrollment downloads a ~300MB model.
ENROLL_TIMEOUT_MS=900000
